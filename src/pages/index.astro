---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import PieceCard from '../components/PieceCard.astro';

const SUBSTACK_URL = 'https://robertpotts.substack.com/';
const LINKEDIN_URL = 'https://uk.linkedin.com/in/robert-potts-rp';

// Pick the hero: the `featured` piece, else the most recent.
const pieces = (await getCollection('pieces', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
const hero = pieces.find((p) => p.data.featured) ?? pieces[0];
---

<BaseLayout title="Robert Potts — About" active="about">
  <div class="page about">
    <div class="about__grid">
      <section class="about__bio" aria-label="About Robert Potts">
        <p>
         I am a writer, critic, editor and manager. I was until 2025 the Deputy Editor of The Times Literary Supplement, and am a former editor of Poetry Review. I have written for many national broadsheets and magazines, including the Guardian, the Observer, The Times, the Sunday Times, the Daily Telegraph, the Independent, the Spectator, the New Statesman, the LRB, and the TLS. My output includes interviews, obituaries, essays, articles, blog posts and reviews, and examples can be found  <a href="/journalism">here</a>.
        </p>
        <p>
          Since leaving the TLS last year, I have divided my time between literary projects – writing, editing, consulting – and pro bono work in the area of education and child literacy, in which I have a long and personal interest, as explained here  <a href="/volunteering">Volunteering</a>.
        </p>

        <ul class="about__links" aria-label="Elsewhere">
          <li>
            <a href={SUBSTACK_URL} target="_blank" rel="noopener noreferrer">Substack ↗</a>
          </li>
          <li>
            <a href={LINKEDIN_URL} target="_blank" rel="noopener noreferrer">LinkedIn ↗</a>
          </li>
        </ul>
      </section>

      {
        hero && (
          <section class="about__featured" aria-label="Featured piece">
            <p class="about__featured-eyebrow">Start here</p>
            <PieceCard
              as="div"
              hero
              slug={hero.id}
              headline={hero.data.headline}
              subheading={hero.data.subheading}
              type={hero.data.type}
              date={hero.data.date}
              image={hero.data.image}
            />
          </section>
        )
      }
    </div>
  </div>
</BaseLayout>

<style>
  .about {
    padding-top: clamp(2rem, 6vw, 4rem);
    padding-bottom: 5rem;
  }
  .about__grid {
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1.1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .about__bio {
    max-width: var(--reading-max);
    font-size: 1.2rem;
  }
  .about__links {
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 1.5rem;
    padding: 0;
    margin: 1.75rem 0 0;
  }
  .about__links a {
    font-size: 1.1rem;
    font-weight: 500;
  }
  .about__featured-eyebrow {
    font-family: var(--font-body);
    font-size: 0.85rem;
    font-weight: 600;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--color-ink-soft);
    margin: 0 0 0.85rem;
  }
  @media (max-width: 52rem) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
