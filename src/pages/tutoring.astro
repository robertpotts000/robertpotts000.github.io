---
import BaseLayout from '../layouts/BaseLayout.astro';
import PageHeader from '../components/PageHeader.astro';
---

<BaseLayout title="Robert Potts – Tutoring" noindex>
  <div class="page tutoring">
    <PageHeader title="Tutoring" />

    <div class="tutoring__grid">
      <div class="tutoring__body">
        <p>
          I offer one-to-one tuition to students ages 8–18 in English language and literature
          for the Kent Test, GCSE and A-level. I currently teach two students for GCSE, in
          addition to my volunteering in primary schools. My Superprof page can be found{' '}<a
            href="https://tinyurl.com/43sjmn4w"
            target="_blank"
            rel="noopener noreferrer">here</a
          >{' '}and my rates depend on location and schedule.
        </p>
      </div>

      <div class="tutoring__gallery" aria-label="Photos">
        <figure class="tutoring__photo">
          <img src="/images/tutoring/robert-potts.jpg" alt="Robert Potts" loading="lazy" />
        </figure>
        <figure class="tutoring__photo">
          <img
            src="/images/volunteering/photo-3.jpeg"
            alt="Thank-you cards from a Year 4 class"
            loading="lazy"
          />
          <figcaption>Year 4 end-of-term cards, 2026</figcaption>
        </figure>
      </div>
    </div>
  </div>
</BaseLayout>

<style>
  .tutoring {
    padding-top: clamp(2rem, 6vw, 4rem);
    padding-bottom: 5rem;
  }
  .tutoring__grid {
    margin-top: clamp(1.5rem, 4vw, 2.75rem);
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .tutoring__body {
    max-width: var(--reading-max);
    font-size: 1.2rem;
  }
  .tutoring__body a {
    text-decoration: underline;
  }
  .tutoring__gallery {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    margin-top: 0.4rem;
  }
  .tutoring__photo {
    margin: 0;
  }
  .tutoring__photo img {
    display: block;
    width: 100%;
    height: auto;
    border-radius: var(--radius);
    border: 1px solid var(--color-line);
  }
  .tutoring__photo figcaption {
    margin-top: 0.5rem;
    font-style: italic;
    font-size: 0.95rem;
    line-height: 1.4;
    color: var(--color-ink-soft);
  }

  @media (max-width: 52rem) {
    .tutoring__grid {
      grid-template-columns: 1fr;
    }
    .tutoring__gallery {
      flex-direction: row;
      flex-wrap: wrap;
      gap: clamp(1rem, 2.5vw, 1.75rem);
      margin-top: 0;
    }
    .tutoring__photo {
      flex: 1 1 calc(50% - 0.75rem);
      min-width: 10rem;
    }
  }
</style>
