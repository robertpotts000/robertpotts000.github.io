---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PieceCarousel from '../../components/PieceCarousel.astro';

const pieces = (
  await getCollection('pieces', (p) => !p.data.draft && p.data.categories.includes('fiction'))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Robert Potts — Fiction" active="journalism" appShell subnav subnavActive="fiction">
  <PieceCarousel title="Fiction" pieces={pieces} ariaLabel="Fiction pieces" />
</BaseLayout>
