---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PieceCarousel from '../../components/PieceCarousel.astro';
import { isGated, teaser } from '../../lib/gating';

const pieces = (await getCollection('pieces', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

// Plain-text body per slug, so the search box can match piece content too,
// not just the headline.
const htmlModules = import.meta.glob('../../pieces/html/*.html', {
  query: '?raw',
  import: 'default',
  eager: true,
});
// A piece under embargo (see src/lib/gating.ts) only shows its first
// paragraph on the page — the search index has to match, or the rest of the
// body would still be readable in the page's HTML source even though it's
// not displayed.
const bodies: Record<string, string> = {};
for (const piece of pieces) {
  const key = Object.keys(htmlModules).find((k) => k.endsWith(`/${piece.id}.html`));
  if (!key) continue;
  let html = htmlModules[key] as string;
  const { sourceUrl } = piece.data;
  if (sourceUrl && isGated(piece.data)) {
    html = teaser(html, sourceUrl) ?? html;
  }
  bodies[piece.id] = html.replace(/<[^>]+>/g, ' ').replace(/\s+/g, ' ').trim();
}
---

<BaseLayout title="Robert Potts — Archive" active="journalism" appShell subnav subnavActive="archive">
  <PieceCarousel title="Archive" pieces={pieces} ariaLabel="All journalism pieces" bodies={bodies} />
</BaseLayout>
