---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PieceCarousel from '../../components/PieceCarousel.astro';

// Robert's chosen reading order, not chronological. Any interview piece not
// listed here (e.g. a new one added later) falls back to the end, newest first.
const ORDER = [
  'margaret-atwood',
  'les-murray',
  'muldoon',
  'thom-gunn',
  'geoffrey-hill-profile',
  'rita-dove',
  'glyn-maxwell',
];

const pieces = (
  await getCollection('pieces', (p) => !p.data.draft && p.data.categories.includes('interviews'))
).sort((a, b) => {
  const ia = ORDER.indexOf(a.id);
  const ib = ORDER.indexOf(b.id);
  if (ia === -1 && ib === -1) return b.data.date.valueOf() - a.data.date.valueOf();
  if (ia === -1) return 1;
  if (ib === -1) return -1;
  return ia - ib;
});
---

<BaseLayout title="Robert Potts — Interviews" active="journalism" appShell>
  <PieceCarousel title="Interviews" pieces={pieces} ariaLabel="Interview pieces" active="interviews" />
</BaseLayout>
