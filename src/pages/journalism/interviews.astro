---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PieceCarousel from '../../components/PieceCarousel.astro';

const pieces = (
  await getCollection('pieces', (p) => !p.data.draft && p.data.categories.includes('interviews'))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Robert Potts — Interviews" active="journalism" appShell>
  <PieceCarousel title="Interviews" pieces={pieces} ariaLabel="Interview pieces" />
</BaseLayout>
