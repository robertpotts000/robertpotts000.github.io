---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PieceCarousel from '../../components/PieceCarousel.astro';

const pieces = (
  await getCollection('pieces', (p) => !p.data.draft && p.data.categories.includes('recreation'))
).sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Robert Potts — Recreations" active="journalism" appShell subnav subnavActive="recreations">
  <PieceCarousel title="Recreations" pieces={pieces} ariaLabel="Recreations pieces" />
</BaseLayout>
