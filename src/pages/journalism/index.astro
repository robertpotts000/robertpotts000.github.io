---
import { getCollection } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import PieceCarousel from '../../components/PieceCarousel.astro';

const pieces = (await getCollection('pieces', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---

<BaseLayout title="Robert Potts — Journalism" active="journalism" appShell>
  <PieceCarousel title="Journalism" pieces={pieces} ariaLabel="Journalism archive">
    <Fragment slot="intro">
      <p>
        Over the years, I have written for nearly all the British broadsheets, and a number of
        magazines - the Guardian, The Times, the Sunday Times, the Independent on Sunday, the
        Daily Telegraph, the Observer, the LRB, the Spectator, the New Statesman, Literary Review,
        and the TLS.
      </p>
      <p>
        I have interviewed some great writers – some examples <a href="/journalism/interviews">here</a> –
        and reviewed many more.
      </p>
      <p>
        While I have specialised in poetry, I have written more widely than that. I have written a
        number of pieces about music (examples <a href="/journalism/music">here</a>), especially of
        a literary nature; and on other topics: from censorship and politics to cigarettes and
        alcohol (and other stimulants and recreations …).
      </p>
      <p>
        The uploading of these pieces is a work in progress, but I hope that whatever brought you
        here, there will be something for you to enjoy.
      </p>
    </Fragment>
  </PieceCarousel>
</BaseLayout>
