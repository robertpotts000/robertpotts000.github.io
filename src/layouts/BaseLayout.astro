---
// Self-hosted fonts (no external requests at runtime → keeps hosting simple).
import '@fontsource/cormorant-garamond/500.css';
import '@fontsource/cormorant-garamond/600.css';
import '@fontsource/cormorant-garamond/700.css';
import '@fontsource/eb-garamond/400.css';
import '@fontsource/eb-garamond/400-italic.css';
import '@fontsource/eb-garamond/500.css';
import '@fontsource/eb-garamond/600.css';

import '../styles/tokens.css';
import '../styles/global.css';
import TopBar from '../components/TopBar.astro';

interface Props {
  /** Page <title>; also drives the browser tab. */
  title: string;
  /** Meta description for search/social. */
  description?: string;
  /** Which nav link to mark active. */
  active?: 'about' | 'journalism' | 'editing';
  /**
   * App-shell mode: the whole viewport is used and only an inner region
   * scrolls (used by the Journalism archive so its header stays frozen).
   * Normal pages scroll the document as usual.
   */
  appShell?: boolean;
}

const {
  title,
  description = 'Robert Potts — literary critic. Journalism, criticism, and editing.',
  active,
  appShell = false,
} = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <meta name="color-scheme" content="light" />
  </head>
  <body class:list={[{ 'app-shell': appShell }]}>
    <TopBar active={active} />
    <main class="site-main">
      <slot />
    </main>

    <style>
      /* Normal pages: document scrolls, top bar sticks to the top. */
      body {
        display: flex;
        flex-direction: column;
        min-height: 100vh;
      }
      .site-main {
        flex: 1 1 auto;
      }

      /* App-shell (Journalism): lock the viewport; only inner regions scroll. */
      body.app-shell {
        height: 100vh;
        min-height: 0;
        overflow: hidden;
      }
      body.app-shell .site-main {
        min-height: 0;
        display: flex;
        flex-direction: column;
      }
    </style>
  </body>
</html>
