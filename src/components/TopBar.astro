---
interface Props {
  active?: 'about' | 'journalism' | 'editing';
}
const { active } = Astro.props;

const links = [
  { href: '/', label: 'About Me', key: 'about' },
  { href: '/journalism', label: 'Journalism', key: 'journalism' },
  { href: '/editing', label: 'Editing', key: 'editing' },
] as const;
---

<header class="topbar">
  <div class="topbar__inner">
    <a class="topbar__brand" href="/">Robert Potts</a>
    <nav class="topbar__nav" aria-label="Primary">
      {
        links.map((l) => (
          <a
            href={l.href}
            class:list={['topbar__link', { 'is-active': active === l.key }]}
            aria-current={active === l.key ? 'page' : undefined}
          >
            {l.label}
          </a>
        ))
      }
    </nav>
  </div>
</header>

<style>
  .topbar {
    position: sticky;
    top: 0;
    z-index: 50;
    flex: 0 0 auto;
    background: var(--color-bg);
    border-bottom: 1px solid var(--color-line);
  }
  .topbar__inner {
    max-width: var(--content-max);
    margin: 0 auto;
    min-height: var(--topbar-h);
    padding: 0 clamp(1.25rem, 4vw, 3rem);
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .topbar__brand {
    font-family: var(--font-display);
    font-weight: 600;
    font-size: 1.65rem;
    letter-spacing: 0.01em;
    color: var(--color-ink);
    text-decoration: none;
    white-space: nowrap;
  }
  .topbar__brand:hover {
    color: var(--color-ink);
    text-decoration: none;
  }
  .topbar__nav {
    display: flex;
    gap: clamp(0.9rem, 2.4vw, 2rem);
    align-items: baseline;
  }
  .topbar__link {
    font-family: var(--font-body);
    font-size: 1.05rem;
    color: var(--color-ink-soft);
    text-decoration: none;
    padding-bottom: 2px;
    border-bottom: 1.5px solid transparent;
    white-space: nowrap;
  }
  .topbar__link:hover {
    color: var(--color-ink);
    text-decoration: none;
    border-bottom-color: var(--color-line);
  }
  .topbar__link.is-active {
    color: var(--color-accent);
    border-bottom-color: var(--color-accent);
  }

  @media (max-width: 34rem) {
    .topbar__brand {
      font-size: 1.4rem;
    }
    .topbar__link {
      font-size: 0.95rem;
    }
    .topbar__inner {
      gap: 0.5rem;
    }
  }
</style>
